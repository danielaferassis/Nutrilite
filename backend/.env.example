APP_NAME=nutrilite-backend
LOG_LEVEL=INFO

# Conexão com o MySQL rodando localmente (ou o do docker-compose exposto na porta 3306).
# Dentro do Docker essa variável é sobrescrita pelo docker-compose.yml.
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/app

# Sessão de login. Em produção (HTTPS) COOKIE_SECURE deve ficar true (o padrão).
COOKIE_SECURE=false
# SESSAO_OCIOSA_MINUTOS=480
# SESSAO_MAXIMA_DIAS=7

# Importação de arquivos (no Docker o diretório é o volume "uploads")
# UPLOADS_DIR=uploads
# UPLOAD_MAX_MB=20
# IMPORTACAO_RETENCAO_DIAS=30
